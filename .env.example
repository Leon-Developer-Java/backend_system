# ================================================================
#  智慧气象 · 后端环境变量配置
#  复制此文件为 .env 并填入实际值
#  注意：不要将包含真实密码的 .env 提交到 Git
# ================================================================

# ---- JWT 鉴权（必须与其他后端完全一致） ----
# 生成命令：python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=

# ---- 共享数据库与存储 ----
# DATABASE_URL=sqlite:///D:/weather_prediction_system/DB/weather.db
# RAW_STORAGE_ROOT=D:/weather_prediction_system/storage/raw
# TMP_STORAGE_ROOT=D:/weather_prediction_system/storage/tmp
# PRODUCT_DATA_ROOT=D:/weather_prediction_system/backend/data

# ---- Adapter Worker ----
# main.py 默认自动启动一个独立 Worker 子进程；生产多 API 进程时设为 false，单独托管 Worker。
START_ADAPTER_WORKER_WITH_API=true
# ADAPTER_QUEUE_SLEEP_SECONDS=2
# ADAPTER_LEASE_SECONDS=1800
# ADAPTER_HEARTBEAT_SECONDS=60
# ADAPTER_MAX_ATTEMPTS=3
# ADAPTER_RETRY_BACKOFF_SECONDS=60,300,1800
# ADAPTER_TIMEOUT_SECONDS=3600
# ADAPTER_TIMEOUT_FY3=3600
# ADAPTER_TIMEOUT_HIMAWARI=3600

# 旧 Himawari 测试调度默认关闭；本版本不要开启。
ENABLE_LEGACY_HIMAWARI_SCHEDULER=false

# ---- 旧 Himawari FTP 测试配置（本版本不使用） ----
HIMAWARI_FTP_USER=你的FTP用户名
HIMAWARI_FTP_PASSWORD=你的FTP密码

# ---- Himawari FTP 服务器（可选） ----
# HIMAWARI_FTP_HOST=ftp.ptree.jaxa.jp
# HIMAWARI_FTP_ROOT=/jma/hsd

# ---- Himawari 自动下载控制 ----
# HIMAWARI_AUTO_DOWNLOAD=0
# HIMAWARI_WINDOW_HOURS=1
# HIMAWARI_LATEST_DELAY_MINUTES=60
# HIMAWARI_DOWNLOAD_INTERVAL_MINUTES=10
# HIMAWARI_DOWNLOAD_INTERVAL_SECONDS=60
# HIMAWARI_DOWNLOAD_MAX_JOBS_PER_RUN=7
# HIMAWARI_FILE_WORKERS=4

# ---- Himawari 通道与输出 ----
# HIMAWARI_BANDS=B13,B03,B02,B01
# HIMAWARI_EXTENT=118.2,31.2,119.4,32.7
# HIMAWARI_OUTPUT_MODE=display

# ---- FY-3 固定业务范围 ----
# FY3_EXTENT=73,15,135,55

# ---- CORS 跨域 ----
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:5177,http://127.0.0.1:5177
